<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>С Днём Рождения, дорогая моя подруга! 💛</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  
  body {
    font-family: 'Georgia', serif;
    background: linear-gradient(135deg, #fdf6f0 0%, #f9e4e8 50%, #e8e4f3 100%);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40px 20px;
    padding-bottom: calc(40px + env(safe-area-inset-bottom)); /* Учет нижней панели iPhone */
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  h1 {
    font-size: 2em;
    color: #b56576;
    text-align: center;
    margin-bottom: 10px;
    line-height: 1.2;
  }
  .subtitle {
    color: #6d597a;
    font-style: italic;
    margin-bottom: 30px;
    text-align: center;
    font-size: 1.1em;
  }

  /* Конверты */
  .envelopes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px;
    max-width: 800px;
    width: 100%;
  }
  .envelope {
    width: 90px;
    height: 90px;
    background: #fff;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(181, 101, 118, 0.15);
    transition: transform 0.3s, box-shadow 0.3s;
    border: 2px dashed #e0b1b8;
  }
  .envelope:hover { transform: translateY(-6px) scale(1.05); }
  .envelope:active { transform: scale(0.95); } /* Эффект нажатия на телефоне */
  .envelope .icon { font-size: 2.5em; transition: transform 0.3s ease; }
  .envelope.opened { border-color: #b56576; background: #fff8f9; border-style: solid; }
  .envelope.opened .icon { animation: pop 0.5s ease; }
  @keyframes pop { 0% { transform: scale(0.5); } 70% { transform: scale(1.3); } 100% { transform: scale(1); } }

  /* Блок с текстом */
  .message-box {
    max-width: 600px;
    width: 100%;
    margin-top: 30px;
    background: #fff;
    border-radius: 20px;
    padding: 25px;
    box-shadow: 0 10px 30px rgba(109, 89, 122, 0.2);
    font-size: 1.1em;
    color: #4a4a4a;
    line-height: 1.7;
    display: none;
    animation: fadeIn 0.5s ease;
  }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  .message-box.show { display: block; }

  /* Фото внутри конвертов */
  .message-box img {
    width: 100%;
    max-height: 500px;
    object-fit: contain;
    border-radius: 12px;
    margin-top: 20px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    display: block;
    background: #fdf6f0;
  }

  /* Финальный блок */
  .final {
    max-width: 650px;
    width: 100%;
    margin-top: 40px;
    background: linear-gradient(135deg, #fff, #fdf0f3);
    border-radius: 24px;
    padding: 30px 20px;
    text-align: center;
    box-shadow: 0 12px 40px rgba(181, 101, 118, 0.25);
    display: none;
    animation: fadeIn 0.8s ease;
    border: 1px solid #f0d3d8;
  }
  .final.show { display: block; }
  .final h2 { color: #b56576; margin-bottom: 20px; font-size: 1.6em; }
  .final p { color: #4a4a4a; line-height: 1.7; margin-bottom: 14px; font-size: 1.05em; }
  .final .signature { margin-top: 20px; font-style: italic; color: #6d597a; }

  /* Галерея */
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 25px 0;
  }
  .gallery-item {
    width: 100%;
    aspect-ratio: 3 / 4;
    background: #fdf6f0;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gallery img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  #confetti-canvas {
    position: fixed; top: 0; left: 0;
    width: 100%; height: 100%;
    pointer-events: none;
    z-index: 999;
  }

  /* ========================================= */
  /* МОБИЛЬНАЯ ВЕРСИЯ (для экранов до 600px) */
  /* ========================================= */
  @media (max-width: 600px) {
    body {
      padding: 20px 12px;
      padding-bottom: calc(20px + env(safe-area-inset-bottom));
    }
    h1 {
      font-size: 1.6em; /* Чуть меньше заголовок */
    }
    .subtitle {
      font-size: 0.95em;
      margin-bottom: 20px;
    }
    .envelopes {
      gap: 10px; /* Плотнее друг к другу */
    }
    .envelope {
      width: 70px; /* Удобный размер для пальца */
      height: 70px;
      border-radius: 12px;
    }
    .envelope .icon {
      font-size: 2em;
    }
    .message-box {
      padding: 20px 15px;
      font-size: 1em; /* Читабельный текст */
      margin-top: 20px;
      border-radius: 16px;
    }
    .message-box img {
      margin-top: 15px;
      max-height: 350px;
    }
    .final {
      padding: 25px 15px;
      margin-top: 25px;
      border-radius: 20px;
    }
    .final h2 {
      font-size: 1.4em;
    }
    .final p {
      font-size: 0.95em;
      line-height: 1.6;
    }
    .gallery {
      grid-template-columns: repeat(2, 1fr); /* На телефоне 2 колонки */
      gap: 8px;
      margin: 20px 0;
    }
    .gallery-item {
      border-radius: 10px;
    }
  }
</style>
</head>
<body>

<h1>С Днём Рождения, дорогая моя подруга! 🎉</h1>
<p class="subtitle">Нажми на каждый конвертик 💌</p>

<div class="envelopes">
  <div class="envelope" data-id="0"><div class="icon">💌</div></div>
  <div class="envelope" data-id="1"><div class="icon">💖</div></div>
  <div class="envelope" data-id="2"><div class="icon">🎀</div></div>
  <div class="envelope" data-id="3"><div class="icon">✨</div></div>
  <div class="envelope" data-id="4"><div class="icon">💍</div></div>
</div>

<div class="message-box" id="msgBox"></div>

<div class="final" id="finalBox">
  <h2>Дорогая моя подруга! 💛</h2>
  
  <div class="gallery">
    <div class="gallery-item"><img src="1.JPG" alt="Фото 1"></div>
    <div class="gallery-item"><img src="2.JPG" alt="Фото 2"></div>
    <div class="gallery-item"><img src="3.JPG" alt="Фото 3"></div>
    <div class="gallery-item"><img src="4.HEIC" alt="Фото 4"></div>
    <div class="gallery-item"><img src="5.JPG" alt="Фото 5"></div>
    <div class="gallery-item"><img src="6.HEIC" alt="Фото 6"></div>
    <div class="gallery-item"><img src="7.HEIC" alt="Фото 7"></div>
    <div class="gallery-item"><img src="8.HEIC" alt="Фото 8"></div>
    <div class="gallery-item"><img src="9.HEIC" alt="Фото 9"></div>
    <div class="gallery-item"><img src="10.HEIC" alt="Фото 10"></div>
  </div>

  <p>От всей души поздравляю тебя С Днём Рождения!</p>
  <p><strong>Желаю тебе в этом году</strong>, чтобы ты была счастлива каждый день и не откладывала жизнь на потом (когда закроешь ипотеку, когда Тимур вернётся с вахты, когда рак на горе свистнет) — счастье в мелочах, в обычных днях, в чашке любимого чая, просмотре сериала, в прогулке по осеннему парку, в кружочках от близких, в утренних ритуалах и в душевных разговорах.</p>
  <p>Пусть здоровье не подводит, а лечение силой мысли всегда работает, пусть мечты не тускнеют и всегда находятся силы на то, что важно именно тебе, а близкие будут рядом, когда это необходимо.</p>
  <p><strong>Желаю тебе беречь себя</strong> — не только когда трудно, а всегда. Отдыхать без чувства вины, говорить «нет» без объяснений, выбирать себя без оправданий. Ты заслуживаешь самого лучшего — помни об этом не только по праздникам.</p>
  <p>Обнимаю тебя крепко,<br>твоя подруженька 💕</p>
</div>

<canvas id="confetti-canvas"></canvas>

<script>
const messages = [
  "💌 <strong>Желаю тебе в этом году</strong>, чтобы ты была счастлива каждый день и не откладывала жизнь на потом — счастье в мелочах, в обычных днях, в чашке любимого чая, просмотре сериала, в прогулке по осеннему парку, в кружочках от близких, в утренних ритуалах и в душевных разговорах.<br><br>Пусть здоровье не подводит, а лечение силой мысли всегда работает, пусть мечты не тускнеют и всегда находятся силы на то, что важно именно тебе, а близкие будут рядом, когда это необходимо.<br><br><strong>Береги себя</strong> — не только когда трудно, а всегда. Отдыхай без чувства вины, говори «нет» без объяснений, выбирай себя без оправданий. Ты заслуживаешь самого лучшего — помни об этом не только по праздникам.<img src='1.JPG' alt='Фото'>",

  "📮 Удивительно, но <strong>61% твоей жизни</strong> составляет наша дружба, которую мы пронесли сквозь расстояния, часовые пояса и целые эпохи жизни. Мы с тобой прошли столько, что иногда кажется, будто мы знакомы не одну жизнь.<br><br>И я хочу сказать, что <strong>ты — один из самых важных людей в моей жизни</strong>. С тобой я не боюсь несмешно пошутить, могу молчать и не чувствовать неловкости, смеяться до слёз над дровами из кошек, и быть настоящей и слабой, не боясь, что это заметят. Это дорогого стоит.<img src='2.JPG' alt='Фото'>",

  "💐 Кто бы мог подумать тогда, <strong>14 лет назад</strong>, что я буду устраивать тебе девичник и мы будем выдавать тебя замуж не за африканца Александра? 😄<br><br>Честно говоря, я очень рада за тебя и твои успехи. Рада, что ты встретила своего человечка и находишься в счастливых и гармоничных отношениях, а теперь ещё и выходишь замуж 🥹🥹🥹 <strong>Счастья вам с Тимуром!</strong><img src='3.JPG' alt='Фото'>",

  "🏡 Рада, что ты нашла <strong>работу по душе</strong>, которая не только приносит деньги, но ещё и удовольствие!<br><br>Рада, что тебя окружают такие замечательные подруги, готовые поддержать в трудную минуту, рассмешить до слёз, вписаться в любую авантюру, а главное — просто быть рядом.<br><br>И рада, что ты в 22 года <strong>САМА купила себе квартиру</strong> (без мам, пап и почти без ипотек) — это тебе не хухры мухры!! Я очень тобой горжусь!<img src='4.HEIC' alt='Фото'>",

  "💕 Я очень ценю нашу дружбу — за то, что она выдерживает и расстояния, и молчание, и разные периоды жизни.<br><br><strong>Спасибо, что ты есть!</strong> Помни, что я всегда на связи — между Москвой и Казанью дружба не заканчивается, она становится крепче.<img src='5.JPG' alt='Фото'>"
];

const envelopes = document.querySelectorAll('.envelope');
const msgBox = document.getElementById('msgBox');
const finalBox = document.getElementById('finalBox');
let opened = new Set();

envelopes.forEach(env => {
  env.addEventListener('click', () => {
    const id = +env.dataset.id;
    env.classList.add('opened');
    opened.add(id);
    msgBox.innerHTML = messages[id];
    msgBox.classList.add('show');
    
    // Плавный скролл к тексту с небольшой задержкой (для мобилок)
    setTimeout(() => {
      msgBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }, 100);

    if (opened.size === envelopes.length) {
      setTimeout(() => {
        finalBox.classList.add('show');
        setTimeout(() => {
          finalBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 100);
        startConfetti();
      }, 600);
    }
  });
});

// Конфетти 🎊
const canvas = document.getElementById('confetti-canvas');
const ctx = canvas.getContext('2d');
let particles = [];
let animating = false;

function resize() {
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
}
resize();
window.addEventListener('resize', resize);

function startConfetti() {
  if (animating) return;
  animating = true;
  const colors = ['#b56576', '#e88d9a', '#f6c1cb', '#e0b1b8', '#d8a7b1', '#f4d3d9', '#c9b6d8'];
  particles = [];
  for (let i = 0; i < 200; i++) {
    particles.push({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height - canvas.height,
      w: 6 + Math.random() * 6,
      h: 8 + Math.random() * 8,
      color: colors[Math.floor(Math.random() * colors.length)],
      vy: 2 + Math.random() * 4,
      vx: -1.5 + Math.random() * 3,
      rot: Math.random() * Math.PI,
      vr: (-0.1 + Math.random() * 0.2),
      life: 0
    });
  }
  animate();
}

function animate() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  let alive = false;
  particles.forEach(p => {
    p.y += p.vy;
    p.x += p.vx;
    p.rot += p.vr;
    p.life++;
    if (p.y < canvas.height + 30) alive = true;
    ctx.save();
    ctx.translate(p.x, p.y);
    ctx.rotate(p.rot);
    ctx.fillStyle = p.color;
    ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
    ctx.restore();
  });
  if (alive) {
    requestAnimationFrame(animate);
  } else {
    animating = false;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
  }
}
</script>

</body>
</html>
